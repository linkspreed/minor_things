# ====================================================================
#  Beispiel-Konfiguration - NICHT direkt als .env verwenden!
#  Diese Werte gehören als GitHub-"Secrets"/"Variables" ins Repo, das
#  den Workflow ausführt (siehe README.md, Abschnitt "Einrichtung").
# ====================================================================

# --- QUELLE: dein Haupt-GitHub-Account mit den 155 Repos -----------
GITHUB_SOURCE_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_SOURCE_OWNER=dein-github-username
GITHUB_SOURCE_OWNER_TYPE=user            # oder: org

# --- ZIEL 1: zweiter GitHub-Account (optional) ----------------------
GITHUB_BACKUP_TOKEN=ghp_yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy
GITHUB_BACKUP_OWNER=dein-zweiter-github-account
GITHUB_BACKUP_OWNER_TYPE=user

# --- ZIEL 2: GitLab (optional) ---------------------------------------
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx
GITLAB_NAMESPACE=dein-gitlab-username
GITLAB_URL=https://gitlab.com

# --- ZIEL 3: Google Drive (optional) ---------------------------------
GDRIVE_FOLDER_ID=1AbCDefDeinOrdnerId
# Kompletter Inhalt der Service-Account-JSON-Datei als EINE Zeile:
GDRIVE_SA_JSON={"type": "service_account", "project_id": "...", ...}

# --- E-MAIL-BENACHRICHTIGUNG (wird bei JEDEM Lauf verschickt) --------
# WICHTIG: Auch die Empfänger-Adresse kommt als Secret rein, damit sie
# im öffentlichen Repo nirgendwo im Klartext auftaucht.
# Format: smtp://benutzer:passwort@server:port  (oder smtp+starttls://...)
MAIL_CONNECTION_URL=smtp://deine.adresse@gmail.com:APP_PASSWORT@smtp.gmail.com:465
NOTIFY_EMAIL=deine.andere.adresse@example.com

# --- Sonstiges ---------------------------------------------------------
BACKUP_WORKDIR=mirrors
GIT_TIMEOUT_SECONDS=1800
QUIET_CONSOLE=true
CLEAN_LOCAL_MIRROR_AFTER_EACH_REPO=true
